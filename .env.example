# ============================================================================
# GNAPRMS — Dokploy & Local Environment Configuration Template
# Copy to .env for local overrides or configure in Dokploy Environment tab
# ============================================================================

# Application Runtime Metadata (Vite build-time variables)
VITE_APP_ENV=production
VITE_APP_NAME="Ghana National AI Projects Registry & Monitoring System (GNAPRMS)"
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=/api

# Neon Serverless PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Backend API Service Port
API_PORT=5000

# Host port mapping when running via docker-compose locally
# (Note: On Dokploy Application mode, set Container Port to 80 in the Domains tab)
PORT=8080

